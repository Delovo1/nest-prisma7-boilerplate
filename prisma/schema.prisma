datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// Таблица пользователей
model User {
  id        Int      @id @default(autoincrement()) // В SQL: id SERIAL PRIMARY KEY\
  role      Role     @default(BUYER)
  username  String   @unique                       // В SQL: username TEXT UNIQUE
  password  String                                 // В SQL: password TEXT
  basket    Basket?                                // Виртуальное поле для NestJS
}

// Таблица корзин (ID корзины равен ID пользователя)
model Basket {
  id        Int             @id                    // В SQL: id INT PRIMARY KEY
  user      User            @relation(fields: [id], references: [id], onDelete: Cascade) // В SQL: REFERENCES "User"(id)
  products  BasketProduct[]                        // Виртуальное поле для NestJS
}

// Таблица связей товаров и корзин (Многие-ко-Многим)
model BasketProduct {
  basketId  Int                                    // В SQL: basketId INT
  productId Int                                    // В SQL: productId INT
  quantity  Int             @default(1)            // В SQL: quantity INT DEFAULT 1

  // Настройка внешних ключей в SQL:
  basket    Basket          @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([basketId, productId])                      // В SQL: PRIMARY KEY (basketId, productId)
}

model Category {
  id       Int               @id @default(autoincrement())
  name     String            @unique
  products ProductCategory[] // Связь с промежуточной таблицей
}

// Таблица товаров
model Product {
  id          Int               @id @default(autoincrement())
  name        String
  price       Float
  description String?
  imageSrc    String?
  categories  ProductCategory[] // Связь с промежуточной таблицей
  baskets     BasketProduct[]
}

// Промежуточная таблица связей Товаров и Категорий (Многие-ко-Многим)
model ProductCategory {
  productId  Int
  categoryId Int
  
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId]) // Составной первичный ключ
}
