datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}
enum OrderStatus {
  PENDING
  CANCELLED
  PAID
}

// Таблица пользователей
model User {
  id        Int      @id @default(autoincrement()) // В SQL: id SERIAL PRIMARY KEY
  role      Role     @default(BUYER)
  username  String   @unique                       // В SQL: username TEXT UNIQUE
  password  String                                 // В SQL: password TEXT
  basket    Basket?                                // Виртуальное поле для NestJS
  products Product[]
  orders Order[]
}

// Таблица корзин (ID корзины равен ID пользователя)
model Basket {
  id        Int             @id                    // В SQL: id INT PRIMARY KEY
  products  BasketProduct[]                       

  user      User            @relation(fields: [id], references: [id], onDelete: Cascade) // В SQL: REFERENCES "User"(id)
}

// Таблица связей товаров и корзин (Многие-ко-Многим)
model BasketProduct {
  basketId  Int                                    // В SQL: basketId INT
  productId Int                                    // В SQL: productId INT
  quantity  Int             @default(1)            // В SQL: quantity INT DEFAULT 1

  basket    Basket          @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([basketId, productId])                      
}

model Category {
  id       Int               @id @default(autoincrement())
  name     String            @unique
  products ProductCategory[] // Связь с промежуточной таблицей
}

// Таблица товаров
model Product {
  id          Int               @id @default(autoincrement())
  name        String
  price       Decimal @db.Decimal(10, 2)
  description String?
  imageSrc    String?
  userId      Int
  categories  ProductCategory[] 
  baskets     BasketProduct[]
  orderItems  OrderItem[]

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Промежуточная таблица связей Товаров и Категорий (Многие-ко-Многим)
model ProductCategory {
  productId  Int
  categoryId Int

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId]) 
}

model Order {
  id Int @id @default(autoincrement())
  createdAt DateTime   @default(now())
  userId Int
  status OrderStatus @default(PENDING)
  deliveryAddress String
  items     OrderItem[]

  user   User   @relation(fields: [userId], references:[id], onDelete: Cascade)
}

model OrderItem {
  orderId   Int
  productId   Int
  title   String
  quantity   Int
  price   Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@id([orderId, productId])
}
